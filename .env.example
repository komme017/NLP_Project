AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Optional. Used by classify.py. Defaults to the Hugging Face Hub mirror
# akdeniz27/roberta-base-cuad if unset. Set this to a local directory only
# if you've downloaded the checkpoint yourself (e.g. from Zenodo) --
# something like ./models/roberta-base-cuad. That directory is gitignored,
# so a real checkpoint dropped there is never committed.
# CUAD_MODEL_PATH=./models/roberta-base-cuad

# Optional. Used by classify.py. How confident the CUAD model needs to be
# on a category's answer span before assigning it (vs. falling through to
# "Other"). Default 0.5 = "as confident as saying there's no answer at
# all". Lower this (e.g. 0.3) if too many clauses are landing on "Other"
# and you want more of them to get a real category, at the cost of more
# low-confidence/wrong picks.
# CUAD_CONFIDENCE_THRESHOLD=0.5
