AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Optional. Used by classify.py. Defaults to the Hugging Face Hub mirror
# akdeniz27/roberta-base-cuad if unset. Set this to a local directory only
# if you've downloaded the checkpoint yourself (e.g. from Zenodo) --
# something like ./models/roberta-base-cuad. That directory is gitignored,
# so a real checkpoint dropped there is never committed.
# CUAD_MODEL_PATH=./models/roberta-base-cuad
